{
    "manifest_version": 3,
    "name": "TrustLens AI Interceptor",
    "version": "1.0",
    "description": "Real-time AI phishing detection and silent tab interception.",
    "permissions": [
      "tabs",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>",
      "http://127.0.0.1:8000/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "TrustLens AI Active"
    }
  }